<Application x:Class="DynamicIsland.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:DynamicIsland.Infrastructure"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <FontFamily x:Key="UiFont">Segoe UI, Microsoft YaHei UI</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- ===== 字号阶梯（六档）=====
             正文之外的尺寸都从这里取：Sm 辅助小字、Base 正文、Md 小标题、
             Lg 标题、Xl 模块大数、Xxl 强调数字。图标字号（7.5/8/9）和
             超大号（22/26/31，月历与大温度）保持各自硬编码，它们不参与排版节奏。 -->
        <sys:Double x:Key="FontSizeSm">9.5</sys:Double>
        <sys:Double x:Key="FontSizeBase">10.5</sys:Double>
        <sys:Double x:Key="FontSizeMd">11.5</sys:Double>
        <sys:Double x:Key="FontSizeLg">13</sys:Double>
        <sys:Double x:Key="FontSizeXl">15</sys:Double>
        <sys:Double x:Key="FontSizeXxl">17</sys:Double>

        <SolidColorBrush x:Key="IslandBgBrush" Color="#F20A0A0E" />
        <SolidColorBrush x:Key="IslandBorderBrush" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#99FFFFFF" />
        <SolidColorBrush x:Key="TertiaryTextBrush" Color="#5CFFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF6C8CFF" />
        <SolidColorBrush x:Key="CardBrush" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#18FFFFFF" />
        <SolidColorBrush x:Key="TrackBrush" Color="#24FFFFFF" />

        <!-- ===== 玻璃质感：岛体顶部镜面高光 + 底部内阴影，卡片微渐变 ===== -->
        <LinearGradientBrush x:Key="IslandSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3AFFFFFF" Offset="0" />
            <GradientStop Color="#12FFFFFF" Offset="0.035" />
            <GradientStop Color="#00FFFFFF" Offset="0.12" />
            <GradientStop Color="#00000000" Offset="0.66" />
            <GradientStop Color="#0E000000" Offset="0.90" />
            <GradientStop Color="#2A000000" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1CFFFFFF" Offset="0" />
            <GradientStop Color="#0CFFFFFF" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="CardInnerEdgeBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="InsetSurfaceBrush" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="ChipSurfaceBrush" Color="#10FFFFFF" />

        <!-- 页头标题 / 图标 -->
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PageIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="PageMetaStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infra:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <infra:InverseBoolConverter x:Key="InverseBool" />
        <infra:RatioToBrushConverter x:Key="RatioToBrush" />
        <infra:RatioToWidthConverter x:Key="RatioToWidth" />
        <infra:RatioToThumbMarginConverter x:Key="RatioToThumbMargin" />
        <infra:NullToVisibilityConverter x:Key="NullToVis" />
        <infra:BytesToImageConverter x:Key="BytesToImage" />

        <!-- 底部标签按钮 -->
        <Style x:Key="TabButtonStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#16FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 媒体控制圆钮 -->
        <Style x:Key="RoundButtonStyle" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#26FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 页头小按钮：翻页 / 清空 / 回到今天 -->
        <Style x:Key="GhostButtonStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#16FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 右键菜单项 / 分组标题 -->
        <Style x:Key="MenuItemStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#16FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MenuGroupTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
            <Setter Property="Margin" Value="10,6,10,3" />
        </Style>
    </Application.Resources>
</Application>
