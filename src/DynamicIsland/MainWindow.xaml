<Window x:Class="DynamicIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="灵动岛"
        Width="540" Height="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="0" Top="0"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- 历史列表专用：8px 命中区、4px 滑块，不占用滚轮切页手势。 -->
        <Style x:Key="HistoryScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Border Width="2" CornerRadius="1" Background="{DynamicResource TrackBrush}" />
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="18" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Border x:Name="Grip" Width="4" CornerRadius="2"
                                                            Background="{DynamicResource SecondaryTextBrush}" Opacity="0.6" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Grip" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Grip" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="Grip" Property="Opacity" Value="1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HistoryScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Margin="5,0,0,0"
                                       Orientation="Vertical" Style="{StaticResource HistoryScrollBarStyle}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 磨砂颗粒：3×3 平铺的细噪点，叠在玻璃层上，透明度极低 -->
        <DrawingBrush x:Key="FrostNoiseBrush" TileMode="Tile" Viewport="0,0,3,3"
                      ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#3AFFFFFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,1,1" />
                            <RectangleGeometry Rect="2,2,1,1" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Transparent" MouseEnter="RootGrid_MouseEnter">

        <Border x:Name="Island"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="204" Height="36"
                CornerRadius="18"
                Margin="0,-2,0,0"
                Background="{DynamicResource IslandBgBrush}"
                BorderBrush="{DynamicResource IslandBorderBrush}"
                BorderThickness="1"
                MouseLeftButtonUp="Island_MouseLeftButtonUp"
                MouseRightButtonUp="Island_MouseRightButtonUp"
                MouseWheel="Island_MouseWheel"
                MouseEnter="Island_MouseEnter"
                MouseLeave="Island_MouseLeave"
                AllowDrop="True"
                DragEnter="Island_DragEnter"
                DragOver="Island_DragOver"
                DragLeave="Island_DragLeave"
                Drop="Island_Drop">
            <Border.Effect>
                <!-- 阴影尽量小：岛体高度每帧都在变，模糊半径直接决定每帧高斯重算的成本 -->
                <DropShadowEffect BlurRadius="12" ShadowDepth="5" Opacity="0.38" Color="#04040A" />
            </Border.Effect>

            <Border.RenderTransform>
                <TranslateTransform x:Name="IslandOffset" />
            </Border.RenderTransform>

            <Grid ClipToBounds="True">

                <!-- ===== 玻璃表面（四层叠出「厚度」）=====
                     底色由 Island 提供；WPF 的 AllowsTransparency 窗口带 WS_EX_LAYERED，
                     DWM 的 Acrylic/Mica 不生效，所以用叠层模拟：
                     ① 整面渐变：顶部镜面高光 → 中段通透 → 底部内阴影（按比例，折叠/展开都自然）
                     ② 顶边 1px 强高光：光源在上
                     ③ 全边 1px 内倒角高光：玻璃边缘的折射亮线
                     ④ 细噪点：压掉渐变的塑料感 -->
                <Border IsHitTestVisible="False"
                        CornerRadius="{Binding CornerRadius, ElementName=Island}"
                        Background="{DynamicResource IslandSurfaceBrush}" />
                <Border IsHitTestVisible="False"
                        CornerRadius="{Binding CornerRadius, ElementName=Island}"
                        BorderBrush="#4DFFFFFF" BorderThickness="0,1,0,0" />
                <Border IsHitTestVisible="False"
                        CornerRadius="{Binding CornerRadius, ElementName=Island}"
                        BorderBrush="#12FFFFFF" BorderThickness="1" />
                <Border IsHitTestVisible="False"
                        CornerRadius="{Binding CornerRadius, ElementName=Island}"
                        Background="{StaticResource FrostNoiseBrush}" Opacity="0.3" />

                <!-- ⑤ 强调色 bloom：跟随当前页的 accent（媒体页更强），
                     让玻璃下面像有光透上来；强度由 ThemeManager.SetBloomStrength 控制。 -->
                <Border IsHitTestVisible="False"
                        CornerRadius="{Binding CornerRadius, ElementName=Island}"
                        Background="{DynamicResource AccentBloomBrush}" />

                <!-- ==================== 折叠态 ==================== -->
                <Grid x:Name="CollapsedContent" Margin="0">
                    <!-- 有媒体 -->
                    <Grid Visibility="{Binding HasMedia, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 封面占位：真正的封面由最上层的 MorphCover 统一绘制（折叠→展开连续 morph），
                             这里只保留 24px 的布局占位，保证标题不会被拉走。 -->
                        <Border x:Name="CollapsedCoverSlot" Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                                Margin="7,0,9,0" VerticalAlignment="Center" Opacity="0">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>

                        <Grid Grid.Column="1" x:Name="TitleClip" ClipToBounds="True">
                            <TextBlock x:Name="CollapsedTitleText" Text="{Binding CollapsedText}"
                                       FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeLg}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" TextWrapping="NoWrap"
                                       HorizontalAlignment="Left">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="TitleShift" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,12,0">
                            <!-- 隐私指示点：麦克风橙 / 摄像头绿 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0"
                                        Visibility="{Binding PrivacyVisible, Converter={StaticResource BoolToVis}}">
                                <Ellipse x:Name="MicDot" Width="6" Height="6" Fill="#FFFF9F0A" Margin="0,0,4,0"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding PrivacyMicActive, Converter={StaticResource BoolToVis}}" />
                                <Ellipse x:Name="CameraDot" Width="6" Height="6" Fill="#FF34C759"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding PrivacyCameraActive, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <!-- 专注倒计时 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding FocusActive, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeSm}"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                           Margin="0,0,4,0" />
                                <TextBlock Text="{Binding FocusText}" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeLg}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- 音乐状态图标：点击切回音乐面板（包一层 20×20 透明按钮，文字字形本身太难点） -->
                            <Border Width="20" Height="20" CornerRadius="10" Background="Transparent"
                                    Cursor="Hand" ToolTip="音乐" Margin="2,0,3,0"
                                    MouseLeftButtonUp="PillMusic_Click">
                                <TextBlock Text="{Binding PlayGlyph}" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeBase}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding ClockText}" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeLg}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding ShowClockInPill, Converter={StaticResource BoolToVis}}" />

                            <!-- 日历入口：点击直接展开日历面板 -->
                            <Border Width="20" Height="20" CornerRadius="10" Background="Transparent"
                                    Cursor="Hand" ToolTip="日历" Margin="3,0,0,0"
                                    MouseLeftButtonUp="PillCalendar_Click">
                                <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeSm}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 无媒体：时间 + 日期 + 天气 -->
                    <Grid Visibility="{Binding HasMedia, Converter={StaticResource InverseBoolToVis}}" Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0" Width="7" Height="7" Fill="#FF34C759" VerticalAlignment="Center" Margin="0,0,9,0" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ClockText}" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeLg}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{Binding DateText}" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeMd}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Cursor="Hand" ToolTip="打开日历"
                                       MouseLeftButtonUp="PillCalendar_Click" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeLg}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"
                                   Visibility="{Binding HasWeather, Converter={StaticResource BoolToVis}}">
                            <Run Text="{Binding WeatherTemperature, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" " /><Run
                                Text="{Binding WeatherDescription, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </Grid>

                <!-- ==================== 展开态 ==================== -->
                <Grid x:Name="ExpandedContent" Visibility="Collapsed" Margin="0">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="ExpandedShift" />
                    </Grid.RenderTransform>
                    <Grid Margin="12,10,22,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 媒体头：只在音乐页 / 歌词页显示；其它功能页（日历、通知…）
                             把这一块高度整块让给内容，不再固定占位。 -->
                        <Grid x:Name="MediaHeader" Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="48" />
                                <RowDefinition Height="14" />
                            </Grid.RowDefinitions>

                        <!-- 媒体条：封面 / 标题 / 控制 -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 封面占位：同样交给 MorphCover 绘制，46×46 位置保持不动 -->
                            <Border x:Name="ExpandedCoverSlot" Grid.Column="0" Width="46" Height="46" CornerRadius="12"
                                    Margin="0,0,11,0" VerticalAlignment="Center" Opacity="0">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ExpandedTitleText" Text="{Binding Title}" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeLg}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Artist}" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBase}"
                                           Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel x:Name="MediaControls" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="0,0,2,0">
                                <!-- 主操作实心强调，其余幽灵钮：同尺寸、同基线，只有播放键抢视觉重量 -->
                                <Border Width="26" Height="26" Background="Transparent" Cursor="Hand"
                                        Margin="-3,0,-3,0" MouseLeftButtonUp="PrevButton_Click">
                                    <Border Width="20" Height="20" CornerRadius="10" Background="Transparent"
                                            BorderBrush="{DynamicResource ControlBrush}" BorderThickness="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                        <TextBlock Text="&#xE892;" FontFamily="{StaticResource IconFont}" FontSize="7.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Border>
                                <Border Width="36" Height="36" Background="Transparent" Cursor="Hand"
                                        Margin="2,0" MouseLeftButtonUp="PlayButton_Click">
                                    <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource AccentBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                        <TextBlock Text="{Binding PlayGlyph}" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeMd}"
                                                   Foreground="{DynamicResource IslandBgBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Border>
                                <Border Width="26" Height="26" Background="Transparent" Cursor="Hand"
                                        Margin="-3,0" MouseLeftButtonUp="NextButton_Click">
                                    <Border Width="20" Height="20" CornerRadius="10" Background="Transparent"
                                            BorderBrush="{DynamicResource ControlBrush}" BorderThickness="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                        <TextBlock Text="&#xE893;" FontFamily="{StaticResource IconFont}" FontSize="7.5"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Border>
                                <Border Width="26" Height="26" Background="Transparent" Cursor="Hand"
                                        Margin="2,0" ToolTip="切换播放器来源"
                                        Visibility="{Binding CanSwitchSource, Converter={StaticResource BoolToVis}}"
                                        MouseLeftButtonUp="SwitchSource_Click">
                                    <Border Width="20" Height="20" CornerRadius="10" Background="Transparent"
                                            BorderBrush="{DynamicResource ControlBrush}" BorderThickness="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                        <TextBlock Text="⇄" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Border>
                                <Border Width="26" Height="26" Background="Transparent" Cursor="Hand"
                                        Margin="2,0" ToolTip="静音 / 取消静音" MouseLeftButtonUp="MuteButton_Click">
                                    <Border Width="20" Height="20" CornerRadius="10" Background="Transparent"
                                            BorderBrush="{DynamicResource ControlBrush}" BorderThickness="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                        <TextBlock Text="{Binding VolumeGlyph}" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeSm}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Border>
                                <!-- 展开态的日历入口：悬停展开后点这里直接进日历 -->
                                <Border Width="26" Height="26" Background="Transparent" Cursor="Hand"
                                        Margin="2,0" ToolTip="日历" MouseLeftButtonUp="PillCalendar_Click">
                                    <Border Width="20" Height="20" CornerRadius="10" Background="Transparent"
                                            BorderBrush="{DynamicResource ControlBrush}" BorderThickness="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                        <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="8"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- 进度条：已播放 / 拖动跳转 / 剩余时间 -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding PositionText}" FontFamily="{StaticResource UiFont}"
                                       FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource TertiaryTextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />

                            <Grid x:Name="ProgressArea" Grid.Column="1" Height="14"
                                  VerticalAlignment="Center" Background="Transparent" Cursor="Hand"
                                  MouseLeftButtonDown="Progress_MouseDown"
                                  MouseMove="Progress_MouseMove"
                                  MouseLeftButtonUp="Progress_MouseUp">
                                <Border x:Name="ProgressTrack" CornerRadius="2"
                                        Background="{DynamicResource TrackBrush}" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="4" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSeeking}" Value="True">
                                                    <Setter Property="Height" Value="6" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="2"
                                        Background="{DynamicResource AccentBrush}" IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Height" Value="4" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSeeking}" Value="True">
                                                    <Setter Property="Height" Value="6" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource RatioToWidth}">
                                            <Binding Path="ProgressRatio" />
                                            <Binding ElementName="ProgressTrack" Path="ActualWidth" />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                                <Ellipse Width="24" Height="24" Fill="{DynamicResource AccentBrush}"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Opacity" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSeeking}" Value="True">
                                                    <Setter Property="Opacity" Value="0.22" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                    <Ellipse.Margin>
                                        <MultiBinding Converter="{StaticResource RatioToThumbMargin}"
                                                      ConverterParameter="24">
                                            <Binding Path="ProgressRatio" />
                                            <Binding ElementName="ProgressTrack" Path="ActualWidth" />
                                        </MultiBinding>
                                    </Ellipse.Margin>
                                </Ellipse>
                                <Ellipse Width="8" Height="8" Fill="#FFFFFFFF"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Width" Value="8" />
                                            <Setter Property="Height" Value="8" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSeeking}" Value="True">
                                                    <Setter Property="Width" Value="10" />
                                                    <Setter Property="Height" Value="10" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                    <Ellipse.Margin>
                                        <MultiBinding Converter="{StaticResource RatioToThumbMargin}"
                                                      ConverterParameter="8">
                                            <Binding Path="ProgressRatio" />
                                            <Binding ElementName="ProgressTrack" Path="ActualWidth" />
                                        </MultiBinding>
                                    </Ellipse.Margin>
                                </Ellipse>
                            </Grid>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock Text="{Binding RemainText}" FontFamily="{StaticResource UiFont}"
                                           FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource TertiaryTextBrush}"
                                           VerticalAlignment="Center" />
                                <Border x:Name="VolumeTrack" Width="44" Height="4" CornerRadius="2"
                                        Background="{DynamicResource TrackBrush}" Margin="9,0,0,0"
                                        VerticalAlignment="Center" Cursor="Hand" ToolTip="拖动调音量，单击静音"
                                        MouseLeftButtonDown="VolumeTrack_MouseDown"
                                        MouseMove="VolumeTrack_MouseMove"
                                        MouseLeftButtonUp="VolumeTrack_MouseUp">
                                    <Border HorizontalAlignment="Left" CornerRadius="2"
                                            Background="{DynamicResource AccentBrush}" Opacity="0.85">
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource RatioToWidth}">
                                                <Binding Path="VolumeRatio" />
                                                <Binding ElementName="VolumeTrack" Path="ActualWidth" />
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                </Border>
                            </StackPanel>
                        </Grid>
                        </Grid>

                        <!-- 内容容器：不再叠一层卡片玻璃，页面内容直接浮在岛体上。
                             之前这里 CardSurfaceBrush + 1px 边框 = 第 5 层半透明白，
                             叠在岛体渐变上会把内容区的对比压平。 -->
                        <Border Grid.Row="1" CornerRadius="14" Background="Transparent"
                                Padding="2,5,2,1" Margin="0,2,0,0">
                            <Grid ClipToBounds="True">

                                <!-- 媒体页：歌词 -->
                                <Grid x:Name="MediaPage" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform />
                                            <TranslateTransform />
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <StackPanel VerticalAlignment="Center"
                                                Visibility="{Binding HasLyrics, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding LyricPrevious}" FontFamily="{StaticResource UiFont}"
                                                   FontSize="{StaticResource FontSizeBase}" Foreground="{DynamicResource TertiaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding LyricCurrent}" FontFamily="{StaticResource UiFont}"
                                                   FontSize="{StaticResource FontSizeXl}" FontWeight="SemiBold"
                                                   Foreground="{Binding LyricCurrentBrush}"
                                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                                                   Margin="0,5,0,5" />
                                        <TextBlock Text="{Binding LyricNext}" FontFamily="{StaticResource UiFont}"
                                                   FontSize="{StaticResource FontSizeBase}" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding LyricNext2}" FontFamily="{StaticResource UiFont}"
                                                   FontSize="{StaticResource FontSizeBase}" Foreground="{DynamicResource TertiaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding HasLyrics, Converter={StaticResource InverseBoolToVis}}">
                                        <StackPanel Orientation="Horizontal" Height="26" HorizontalAlignment="Center">
                                            <!-- 柱子统一按 26 布局，播放时只缩放 ScaleY：
                                                 Height 动画每帧都要重新测量，6 根一起做在软件渲染下很亏 -->
                                            <Border x:Name="Spectrum0" Width="3" Height="26" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                                                    VerticalAlignment="Bottom" Margin="2,0" Opacity="0.55" RenderTransformOrigin="0.5,1">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleY="0.38" />
                                                </Border.RenderTransform>
                                            </Border>
                                            <Border x:Name="Spectrum1" Width="3" Height="26" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                                                    VerticalAlignment="Bottom" Margin="2,0" Opacity="0.75" RenderTransformOrigin="0.5,1">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleY="0.69" />
                                                </Border.RenderTransform>
                                            </Border>
                                            <Border x:Name="Spectrum2" Width="3" Height="26" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                                                    VerticalAlignment="Bottom" Margin="2,0" RenderTransformOrigin="0.5,1">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleY="1" />
                                                </Border.RenderTransform>
                                            </Border>
                                            <Border x:Name="Spectrum3" Width="3" Height="26" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                                                    VerticalAlignment="Bottom" Margin="2,0" Opacity="0.65" RenderTransformOrigin="0.5,1">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleY="0.54" />
                                                </Border.RenderTransform>
                                            </Border>
                                            <Border x:Name="Spectrum4" Width="3" Height="26" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                                                    VerticalAlignment="Bottom" Margin="2,0" Opacity="0.85" RenderTransformOrigin="0.5,1">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleY="0.77" />
                                                </Border.RenderTransform>
                                            </Border>
                                            <Border x:Name="Spectrum5" Width="3" Height="26" CornerRadius="2" Background="{DynamicResource AccentBrush}"
                                                    VerticalAlignment="Bottom" Margin="2,0" Opacity="0.5" RenderTransformOrigin="0.5,1">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleY="0.31" />
                                                </Border.RenderTransform>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="暂无歌词" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBase}"
                                                   Foreground="{DynamicResource TertiaryTextBrush}"
                                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- 天气页：大温度 + 图标 + 指标 + 三日预报小卡 -->
                                <Grid x:Name="WeatherPage" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform />
                                            <TranslateTransform />
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="1,0,1,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="3" Height="11" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Opacity="0.9" VerticalAlignment="Center" />
                                            <TextBlock Text="天气" Style="{StaticResource PageTitleStyle}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding WeatherLocation}" Style="{StaticResource PageMetaStyle}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Margin="2,2,14,0">
                                            <TextBlock Text="{Binding WeatherIcon}" FontFamily="{StaticResource UiFont}"
                                                       FontSize="26" VerticalAlignment="Center" Margin="0,0,8,2" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding WeatherTemperature}" FontFamily="{StaticResource UiFont}"
                                                           FontSize="31" FontWeight="Light" LineHeight="34"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                                <TextBlock Text="{Binding WeatherDescription}" FontFamily="{StaticResource UiFont}"
                                                           FontSize="{StaticResource FontSizeBase}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="2,-2,0,0" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 指标改成三列小格：比一整行「体感 28° · 湿度 66% · 风 22 km/h」
                                             更好扫读，也避免窄宽度下折行折得难看 -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2,6,0">
                                            <StackPanel Margin="0,0,13,0">
                                                <TextBlock Text="体感" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                                           Foreground="{DynamicResource TertiaryTextBrush}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding WeatherFeelsLike}" FontFamily="{StaticResource UiFont}"
                                                           FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,13,0">
                                                <TextBlock Text="湿度" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                                           Foreground="{DynamicResource TertiaryTextBrush}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding WeatherHumidity}" FontFamily="{StaticResource UiFont}"
                                                           FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="风速" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                                           Foreground="{DynamicResource TertiaryTextBrush}" HorizontalAlignment="Right" />
                                                <TextBlock FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeLg}" FontWeight="SemiBold"
                                                           HorizontalAlignment="Right" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource PrimaryTextBrush}">
                                                    <Run Text="{Binding WeatherWind, Mode=OneWay}" /><Run Text=" " /><Run Text="km/h"
                                                                                                         FontSize="{StaticResource FontSizeSm}"
                                                                                                         Foreground="{DynamicResource TertiaryTextBrush}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding WeatherForecastParts}" Margin="0,4,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource InsetSurfaceBrush}" CornerRadius="8"
                                                        Padding="8,5" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource UiFont}"
                                                               FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource SecondaryTextBrush}"
                                                               TextAlignment="Center" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <!-- 硬件页：2×2 指标卡片 -->
                                <Grid x:Name="HardwarePage" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform />
                                            <TranslateTransform />
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="1,0,1,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="3" Height="11" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Opacity="0.9" VerticalAlignment="Center" />
                                            <TextBlock Text="性能" Style="{StaticResource PageTitleStyle}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="实时" Style="{StaticResource PageMetaStyle}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource InsetSurfaceBrush}"
                                        CornerRadius="10" Padding="10,8" Margin="0,0,4,4">
                                    <Grid>
                                        <!-- 折线已经表达了历史趋势，底部那条同源进度条是重复信息，删掉换成大号数值 -->
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="CPU" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding CpuText}" FontFamily="{StaticResource UiFont}"
                                                       FontSize="{StaticResource FontSizeXxl}" FontWeight="SemiBold" Margin="0,1,0,0"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </StackPanel>
                                        <Polyline Points="{Binding CpuHistoryPoints}" Stretch="None"
                                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2"
                                                  Width="88" Height="22" Opacity="0.85"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource InsetSurfaceBrush}"
                                        CornerRadius="10" Padding="10,8" Margin="4,0,0,4">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="内存" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding MemoryText}" FontFamily="{StaticResource UiFont}"
                                                       FontSize="{StaticResource FontSizeXxl}" FontWeight="SemiBold" Margin="0,1,0,0"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </StackPanel>
                                        <Polyline Points="{Binding MemoryHistoryPoints}" Stretch="None"
                                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2"
                                                  Width="88" Height="22" Opacity="0.85"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource InsetSurfaceBrush}"
                                        CornerRadius="10" Padding="10,8" Margin="0,4,4,0"
                            Visibility="{Binding HasGpu, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="GPU" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding GpuText}" FontFamily="{StaticResource UiFont}"
                                                       FontSize="{StaticResource FontSizeXxl}" FontWeight="SemiBold" Margin="0,1,0,0"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </StackPanel>
                                        <Polyline Points="{Binding GpuHistoryPoints}" Stretch="None"
                                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2"
                                                  Width="88" Height="22" Opacity="0.85"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource InsetSurfaceBrush}"
                                        CornerRadius="10" Padding="10,8" Margin="4,4,0,0">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="磁盘" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Text="{Binding DiskText}" FontFamily="{StaticResource UiFont}"
                                                       FontSize="{StaticResource FontSizeXxl}" FontWeight="SemiBold" Margin="0,1,0,0"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </StackPanel>
                                        <Polyline Points="{Binding DiskHistoryPoints}" Stretch="None"
                                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2"
                                                  Width="88" Height="22" Opacity="0.85"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                    </Grid>

                                    <TextBlock Grid.Row="2" Text="{Binding NetworkText}"
                                               FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                               Foreground="{DynamicResource TertiaryTextBrush}"
                                               HorizontalAlignment="Center" Margin="0,5,0,0" />
                                </Grid>

                                <!-- 图标坞 -->
                                <Grid x:Name="LauncherPage" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform />
                                            <TranslateTransform />
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="1,0,1,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="3" Height="11" CornerRadius="1.5"
                                                    Background="{DynamicResource AccentBrush}" Opacity="0.9" />
                                            <TextBlock Text="图标坞" Style="{StaticResource PageTitleStyle}"
                                                       Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="拖入快捷方式" Style="{StaticResource PageMetaStyle}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding LauncherErrorText}"
                                               FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                               Foreground="#FFFF8A8A" HorizontalAlignment="Left"
                                               TextTrimming="CharacterEllipsis" Margin="4,0,0,3"
                                               Visibility="{Binding HasLauncherError, Converter={StaticResource BoolToVis}}" />

                                    <TextBlock Grid.Row="2" Text="把桌面快捷方式拖到岛上即可暂存"
                                               FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBase}"
                                               Foreground="{DynamicResource TertiaryTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasLaunchers, Converter={StaticResource InverseBoolToVis}}" />

                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="ContentScroll_PreviewMouseWheel"
                                                  Visibility="{Binding HasLaunchers, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding Launchers}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <!-- 固定六列，第七项始终从第二行开始；不再按临界宽度自动换行。 -->
                                                    <UniformGrid Columns="6" VerticalAlignment="Top" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="44" Height="44" CornerRadius="10" Margin="3"
                                                            Cursor="Hand" ToolTip="{Binding Name}" Tag="{Binding}"
                                                            PreviewMouseLeftButtonDown="Launcher_PreviewMouseLeftButtonDown"
                                                            MouseMove="Launcher_MouseMove"
                                                            MouseLeftButtonUp="Launcher_Click"
                                                            MouseRightButtonUp="Launcher_RightClick">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#22FFFFFF" />
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Image Source="{Binding Icon}" Width="28" Height="28"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>

                                <!-- 通知页：固定行高列表 + 分隔线 -->
                                <Grid x:Name="NotificationPage" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform />
                                            <TranslateTransform />
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="1,0,1,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="3" Height="11" CornerRadius="1.5"
                                                    Background="{DynamicResource AccentBrush}" Opacity="0.9" />
                                            <TextBlock Text="动态" Style="{StaticResource PageTitleStyle}"
                                                       Margin="7,0,0,0" VerticalAlignment="Center" />

                                            <!-- 分段 chip：通知 / 剪贴板（同一页两种内容，互斥显示） -->
                                            <Border Margin="11,0,0,0" Padding="7,2.5" CornerRadius="7" Cursor="Hand"
                                                    Tag="notifications" MouseLeftButtonUp="DynamicMode_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDynamicNotifications}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                <Setter Property="Opacity" Value="0.90" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="通知" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDynamicNotifications}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource IslandBgBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <Border Margin="4,0,0,0" Padding="7,2.5" CornerRadius="7" Cursor="Hand"
                                                    Tag="clipboard" MouseLeftButtonUp="DynamicMode_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDynamicClipboard}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                <Setter Property="Opacity" Value="0.90" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="剪贴板" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDynamicClipboard}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource IslandBgBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" Style="{StaticResource GhostButtonStyle}"
                                                MouseLeftButtonUp="ClearDynamic_Click"
                                                Visibility="{Binding HasDynamicItems, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="清空" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{Binding NotificationStatusText}"
                                               FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                               Foreground="{DynamicResource TertiaryTextBrush}"
                                               Margin="4,0,0,3" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding ShowNotificationPanel, Converter={StaticResource BoolToVis}}" />

                                    <TextBlock Grid.Row="1" Text="{Binding ClipboardStatus}"
                                               FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                               Foreground="{DynamicResource TertiaryTextBrush}"
                                               Margin="4,0,0,3" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding ShowClipboardPanel, Converter={StaticResource BoolToVis}}" />

                                    <TextBlock Grid.Row="2" Text="暂无通知" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBase}"
                                               Foreground="{DynamicResource TertiaryTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding ShowNotificationEmpty, Converter={StaticResource BoolToVis}}" />

                                    <TextBlock Grid.Row="2" Text="暂无剪贴记录" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBase}"
                                               Foreground="{DynamicResource TertiaryTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding ShowClipboardEmpty, Converter={StaticResource BoolToVis}}" />

                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"
                                                  Style="{StaticResource HistoryScrollViewerStyle}"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  PreviewMouseWheel="ContentScroll_PreviewMouseWheel"
                                                  Thumb.DragStarted="HistoryScroll_DragStarted"
                                                  Thumb.DragCompleted="HistoryScroll_DragCompleted"
                                                  Visibility="{Binding ShowNotificationPanel, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding Notifications}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Border CornerRadius="8" Padding="6,5" Background="Transparent"
                                                                Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="Notification_Click">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#10FFFFFF" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="24" Height="24" CornerRadius="7"
                                                                        Background="{Binding PlaceholderBrush}"
                                                                        VerticalAlignment="Top" Margin="0,0,8,0">
                                                                    <Grid>
                                                                        <Image Source="{Binding Icon}" Stretch="Uniform" Margin="4"
                                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                                               Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                                                        <TextBlock Text="{Binding Initial}" FontSize="{StaticResource FontSizeBase}" FontWeight="SemiBold"
                                                                                   Foreground="#FFFFFFFF"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                   Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}" />
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" ClipToBounds="True">
                                                                    <TextBlock Text="{Binding DisplayTitleOneLine}" FontFamily="{StaticResource UiFont}"
                                                                               FontSize="{StaticResource FontSizeMd}" Foreground="{DynamicResource PrimaryTextBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding BodyOneLine}" FontFamily="{StaticResource UiFont}"
                                                                               FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource TertiaryTextBrush}"
                                                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" Text="{Binding TimeText}"
                                                                           FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                                                           Foreground="{DynamicResource TertiaryTextBrush}"
                                                                           VerticalAlignment="Top" Margin="0,3,0,0" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Height="1" Background="{DynamicResource DividerBrush}"
                                                                Opacity="0.5" VerticalAlignment="Bottom" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4"
                                                  Style="{StaticResource HistoryScrollViewerStyle}"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  PreviewMouseWheel="ContentScroll_PreviewMouseWheel"
                                                  Thumb.DragStarted="HistoryScroll_DragStarted"
                                                  Thumb.DragCompleted="HistoryScroll_DragCompleted"
                                                  Visibility="{Binding ShowClipboardPanel, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl ItemsSource="{Binding ClipboardItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Border CornerRadius="8" Padding="6,5" Background="Transparent"
                                                                Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="Clipboard_Click">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#10FFFFFF" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="32" Height="24" CornerRadius="6"
                                                                        Background="{DynamicResource ControlBrush}"
                                                                        VerticalAlignment="Top" Margin="0,0,8,0"
                                                                        ClipToBounds="True">
                                                                    <Grid>
                                                                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}"
                                                                                   FontSize="{StaticResource FontSizeBase}" Foreground="{DynamicResource AccentBrush}"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                   Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                                               Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" />
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" ClipToBounds="True">
                                                                    <TextBlock Text="{Binding PreviewOneLine}" FontFamily="{StaticResource UiFont}"
                                                                               FontSize="{StaticResource FontSizeBase}" Foreground="{DynamicResource PrimaryTextBrush}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Meta}" FontFamily="{StaticResource UiFont}"
                                                                               FontSize="{StaticResource FontSizeSm}" Foreground="{DynamicResource TertiaryTextBrush}"
                                                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" Text="{Binding TimeText}"
                                                                           FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                                                           Foreground="{DynamicResource TertiaryTextBrush}"
                                                                           VerticalAlignment="Top" Margin="0,3,0,0" />
                                                            </Grid>
                                                        </Border>
                                                        <Border Height="1" Background="{DynamicResource DividerBrush}"
                                                                Opacity="0.5" VerticalAlignment="Bottom" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>

                                <!-- 日历页：独立占满整个面板（不再和媒体条抢高度） -->
                                <!-- 日历页：左侧月历 + 右侧日期详情（媒体条在此页隐藏） -->
                                <Grid x:Name="CalendarPage" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform />
                                            <TranslateTransform />
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <!-- ===== 左：月历 ===== -->
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <!-- 月份 + 上/下月：标题与按钮垂直居中对齐，不互相挤压 -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="3" Height="11" CornerRadius="1.5"
                                                        Background="{DynamicResource AccentBrush}" Opacity="0.9" />
                                                <TextBlock Text="{Binding CalendarTitle}" FontFamily="{StaticResource UiFont}"
                                                           FontSize="{StaticResource FontSizeXl}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           Margin="7,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <Border Width="22" Height="22" CornerRadius="11" Cursor="Hand"
                                                        Background="{DynamicResource ControlBrush}" ToolTip="上个月"
                                                        MouseLeftButtonUp="CalendarPrev_Click">
                                                    <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="8"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border Width="22" Height="22" CornerRadius="11" Cursor="Hand" Margin="5,0,0,0"
                                                        Background="{DynamicResource ControlBrush}" ToolTip="下个月"
                                                        MouseLeftButtonUp="CalendarNext_Click">
                                                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="8"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 星期标题：与日期网格同列宽 -->
                                        <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,4">
                                            <TextBlock Text="一" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                                       Foreground="{DynamicResource TertiaryTextBrush}" TextAlignment="Center" />
                                            <TextBlock Text="二" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                                       Foreground="{DynamicResource TertiaryTextBrush}" TextAlignment="Center" />
                                            <TextBlock Text="三" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                                       Foreground="{DynamicResource TertiaryTextBrush}" TextAlignment="Center" />
                                            <TextBlock Text="四" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                                       Foreground="{DynamicResource TertiaryTextBrush}" TextAlignment="Center" />
                                            <TextBlock Text="五" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                                       Foreground="{DynamicResource TertiaryTextBrush}" TextAlignment="Center" />
                                            <TextBlock Text="六" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                                       Foreground="{DynamicResource TertiaryTextBrush}" TextAlignment="Center" />
                                            <TextBlock Text="日" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                                       Foreground="{DynamicResource TertiaryTextBrush}" TextAlignment="Center" />
                                        </UniformGrid>

                                        <!-- 6×7 日期网格：等宽等高，数字居中 -->
                                        <ItemsControl x:Name="CalendarGrid" Grid.Row="2" ItemsSource="{Binding CalendarDays}"
                                                    Height="204" VerticalAlignment="Top">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="7" Rows="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="DayCell" Margin="1.5" CornerRadius="9" Background="Transparent"
                                                            Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="CalendarDay_Click">
                                                        <Grid>
                                                            <Border x:Name="TodayFill" Width="28" Height="28" CornerRadius="14"
                                                                    Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                                            <Border x:Name="SelectedRing" Width="28" Height="28" CornerRadius="14"
                                                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.4"
                                                                    Visibility="Collapsed" />
                                                            <TextBlock x:Name="DayText" Text="{Binding Day}"
                                                                       FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeMd}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <Trigger SourceName="DayCell" Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="DayCell" Property="Background"
                                                                    Value="{DynamicResource ControlBrush}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                            <Setter TargetName="DayText" Property="Opacity" Value="0.32" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="SelectedRing" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="DayText" Property="Foreground"
                                                                    Value="{DynamicResource AccentBrush}" />
                                                            <Setter TargetName="DayText" Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter TargetName="TodayFill" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="SelectedRing" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="DayText" Property="Foreground" Value="#FF0B0B10" />
                                                            <Setter TargetName="DayText" Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>

                                    <!-- 右栏用一块极淡底衬托，替代原先那条孤零零的竖线：
                                         去内容卡后 1px 白线成为画面里唯一的硬边，淡底色块更融 -->
                                    <Border Grid.Column="1" Grid.ColumnSpan="2" CornerRadius="10" Opacity="0.55"
                                            Background="{DynamicResource ControlBrush}" Margin="8,6,0,6" />

                                    <!-- ===== 右：日期详情 ===== -->
                                    <Grid Grid.Column="2" Margin="17,10,10,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0">
                                            <TextBlock Text="{Binding CalendarSelectedDate}" FontFamily="{StaticResource UiFont}"
                                                       FontSize="{StaticResource FontSizeXxl}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Text="{Binding CalendarSelectedWeekday}" FontFamily="{StaticResource UiFont}"
                                                       FontSize="{StaticResource FontSizeMd}" Foreground="{DynamicResource SecondaryTextBrush}"
                                                       Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding CalendarSelectedLunar}" FontFamily="{StaticResource UiFont}"
                                                       FontSize="{StaticResource FontSizeBase}" Foreground="{DynamicResource TertiaryTextBrush}"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding HasCalendarLunar, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>

                                        <!-- 空状态：小型线性日历图标 + 一句提示 -->
                                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                                       Foreground="{DynamicResource TertiaryTextBrush}" Opacity="0.45"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding CalendarScheduleHint}" FontFamily="{StaticResource UiFont}"
                                                       FontSize="{StaticResource FontSizeBase}" Foreground="{DynamicResource TertiaryTextBrush}"
                                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                                       TextAlignment="Center" />
                                        </StackPanel>

                                        <!-- 低存在感的回到今天 -->
                                        <Border Grid.Row="2" CornerRadius="8" Padding="8,4" Cursor="Hand"
                                                Background="Transparent" HorizontalAlignment="Left"
                                                MouseLeftButtonUp="CalendarToday_Click">
                                            <TextBlock Text="回到今天" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBase}"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                    </Grid>

                    <!-- 右侧分页点：活动项拉长成胶囊，点击可切页；滚轮也能切 -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0">
                        <Border Width="14" Height="16" Background="Transparent" Cursor="Hand" Tag="0"
                                MouseLeftButtonUp="Tab_Click">
                            <Border x:Name="TabDotIndicator0" Width="4" Height="4" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource PrimaryTextBrush}" Opacity="0.25" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <Border Width="14" Height="16" Background="Transparent" Cursor="Hand" Tag="1"
                                MouseLeftButtonUp="Tab_Click">
                            <Border x:Name="TabDotIndicator1" Width="4" Height="4" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource PrimaryTextBrush}" Opacity="0.25" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <Border Width="14" Height="16" Background="Transparent" Cursor="Hand" Tag="2"
                                MouseLeftButtonUp="Tab_Click">
                            <Border x:Name="TabDotIndicator2" Width="4" Height="4" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource PrimaryTextBrush}" Opacity="0.25" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <Border Width="14" Height="16" Background="Transparent" Cursor="Hand" Tag="3"
                                MouseLeftButtonUp="Tab_Click">
                            <Border x:Name="TabDotIndicator3" Width="4" Height="4" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource PrimaryTextBrush}" Opacity="0.25" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <Border Width="14" Height="16" Background="Transparent" Cursor="Hand" Tag="4"
                                MouseLeftButtonUp="Tab_Click">
                            <Border x:Name="TabDotIndicator4" Width="4" Height="4" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource PrimaryTextBrush}" Opacity="0.25" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <Border Width="14" Height="16" Background="Transparent" Cursor="Hand" Tag="5"
                                MouseLeftButtonUp="Tab_Click">
                            <Border x:Name="TabDotIndicator5" Width="4" Height="4" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource PrimaryTextBrush}" Opacity="0.25" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </StackPanel>
                </Grid>


                <!-- ==================== 通知卡片 ==================== -->
                <Grid x:Name="NotificationContent" Visibility="Collapsed" Margin="18,12,18,12"
                      Background="Transparent" Cursor="Hand" MouseLeftButtonUp="NotificationCard_Click"
                      RenderTransformOrigin="0.5,0.35">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="NotificationScale" />
                            <TranslateTransform x:Name="NotificationShift" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9" Background="{DynamicResource CardBrush}"
                            VerticalAlignment="Center">
                        <Grid>
                            <Image Source="{Binding NotificationIcon}" Stretch="Uniform" Margin="5"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasNotificationIcon, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding NotificationInitial}" FontSize="{StaticResource FontSizeXl}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasNotificationIcon, Converter={StaticResource InverseBoolToVis}}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding NotificationApp}" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBase}"
                                   Foreground="{DynamicResource TertiaryTextBrush}" />
                        <TextBlock Text="{Binding NotificationTitle}" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeLg}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding NotificationBody}" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBase}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    </StackPanel>
                </Grid>

                <!-- ==================== 封面 morph 层 ==================== -->
                <!-- 折叠 24 圆 → 展开 46 圆角方形：同一个元素跟着岛体高度插值尺寸和位置，
                     折叠/展开两套内容里的封面只保留布局占位。圆角固定 12，
                     尺寸连续变大时形状会自然从圆形过渡到圆角方形（参考灵动岛的做法）。 -->
                <Border x:Name="MorphCover" Width="46" Height="46" CornerRadius="12"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,11,0,0"
                        IsHitTestVisible="False" Visibility="Collapsed" RenderTransformOrigin="0,0">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="MorphScale" />
                            <!-- 换歌过渡专用：只动这一个，避免和 MorphScale 每帧写尺寸打架 -->
                            <ScaleTransform x:Name="CoverSwap" CenterX="23" CenterY="23" />
                            <TranslateTransform x:Name="MorphShift" />
                        </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>

                <!-- 拖放高亮 -->
                <Border x:Name="DropHint" Visibility="Collapsed" CornerRadius="18" Background="#3348A0FF"
                        BorderBrush="#FF6C8CFF" BorderThickness="2">
                    <TextBlock Text="松手加入图标坞" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeLg}"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- 音量浮层：跟随岛体底部（折叠/展开都显示），不参与命中测试 -->
        <StackPanel x:Name="VolumeHud" Orientation="Horizontal" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    IsHitTestVisible="False">
            <!-- 定位走 RenderTransform：改 Margin 会让整个窗口重排，而它每帧都跟着岛高变 -->
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="VolumeAnchor" />
            </StackPanel.RenderTransform>
            <Border CornerRadius="17" Background="{DynamicResource IslandBgBrush}"
                    BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1" Padding="13,7">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.45" Color="#000000" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding VolumeGlyph}" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeLg}"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Text="{Binding VolumeText}" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeLg}"
                               FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"
                               Width="36" VerticalAlignment="Center" />
                    <Border x:Name="VolumeHudTrack" Width="72" Height="4" CornerRadius="2"
                            Background="{DynamicResource TrackBrush}" VerticalAlignment="Center">
                        <Border HorizontalAlignment="Left" CornerRadius="2" Background="{DynamicResource AccentBrush}">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource RatioToWidth}">
                                    <Binding Path="VolumeRatio" />
                                    <Binding ElementName="VolumeHudTrack" Path="ActualWidth" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 系统事件浮层（电源 / USB / 蓝牙 / 键盘锁 / 专注结束） -->
        <Border x:Name="SystemAlertHud" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
                CornerRadius="17" Background="{DynamicResource IslandBgBrush}"
                BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1" Padding="14,8"
                IsHitTestVisible="False" MaxWidth="480" Opacity="0">
            <Border.RenderTransform>
                <!-- 第一层跟随岛高定位，第二层做入场位移，互不覆盖 -->
                <TransformGroup>
                    <TranslateTransform x:Name="AlertAnchor" />
                    <TranslateTransform x:Name="AlertShift" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.45" Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="AlertIcon" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeLg}"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="AlertTitle" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeLg}"
                               FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <TextBlock x:Name="AlertDetail" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 剪贴板缩略浮层 -->
        <Border x:Name="ClipboardHud" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
                CornerRadius="15" Background="{DynamicResource IslandBgBrush}"
                BorderBrush="{DynamicResource IslandBorderBrush}" BorderThickness="1" Padding="10,7"
                IsHitTestVisible="False" MaxWidth="440" Opacity="0">
            <Border.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="ClipAnchor" />
                    <TranslateTransform x:Name="ClipShift" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.45" Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Border Width="46" Height="32" CornerRadius="6" Background="{DynamicResource ControlBrush}"
                        Margin="0,0,10,0" ClipToBounds="True" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="ClipIcon" Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeLg}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="ClipThumb" Stretch="UniformToFill" Visibility="Collapsed" />
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center" MaxWidth="330">
                    <TextBlock x:Name="ClipPreview" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeBase}"
                               Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    <TextBlock x:Name="ClipMeta" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                               Foreground="{DynamicResource TertiaryTextBrush}" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 右键菜单（自绘，避免系统浅色主题在透明窗口上渲染成白框） -->
        <Canvas x:Name="MenuLayer">
            <Border x:Name="ContextMenuPanel" Visibility="Collapsed" Width="204"
                    Background="{DynamicResource MenuBgBrush}" BorderBrush="{DynamicResource IslandBorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="7">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.58" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <Border x:Name="MenuAutoStartItem" Style="{StaticResource MenuItemStyle}"
                            MouseLeftButtonUp="MenuAutoStart_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeLg}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="MenuAutoStartText" Grid.Column="1" Text="开机自启"
                                       FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeLg}"
                                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="MenuAutoStartCheck" Grid.Column="2" Text="&#xE73E;"
                                       FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeMd}"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource MenuItemStyle}" MouseLeftButtonUp="MenuSettings_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeLg}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="设置…" FontFamily="{StaticResource UiFont}"
                                       FontSize="{StaticResource FontSizeLg}" Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- 专注计时：25 / 50 分钟专注，5 分钟休息 -->
                    <Border Padding="9,5" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeLg}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="专注" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeMd}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="26" Height="19" CornerRadius="9.5" Background="{DynamicResource ControlBrush}"
                                        Cursor="Hand" Tag="25" MouseLeftButtonUp="FocusStart_Click" ToolTip="专注 25 分钟">
                                    <TextBlock Text="25" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Width="26" Height="19" CornerRadius="9.5" Background="{DynamicResource ControlBrush}"
                                        Cursor="Hand" Tag="50" MouseLeftButtonUp="FocusStart_Click" Margin="4,0,0,0" ToolTip="专注 50 分钟">
                                    <TextBlock Text="50" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Width="26" Height="19" CornerRadius="9.5" Background="{DynamicResource ControlBrush}"
                                        Cursor="Hand" Tag="5" MouseLeftButtonUp="FocusStart_Click" Margin="4,0,0,0" ToolTip="休息 5 分钟">
                                    <TextBlock Text="5" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Width="26" Height="19" CornerRadius="9.5" Background="{DynamicResource TrackBrush}"
                                        Cursor="Hand" Tag="stop" MouseLeftButtonUp="FocusStop_Click" Margin="6,0,0,0" ToolTip="结束计时">
                                    <TextBlock Text="停" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeSm}"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="7,4" />
                    <TextBlock Text="主题" Style="{StaticResource MenuGroupTitleStyle}" />

                    <Border Style="{StaticResource MenuItemStyle}" Tag="obsidian" MouseLeftButtonUp="MenuTheme_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9" Height="9" Fill="#6C8CFF" VerticalAlignment="Center" />
                            <TextBlock x:Name="MenuThemeObsidianText" Grid.Column="1" Text="曜石"
                                       FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeLg}"
                                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="MenuThemeObsidianCheck" Grid.Column="2" Text="&#xE73E;"
                                       FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeMd}"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource MenuItemStyle}" Tag="graphite" MouseLeftButtonUp="MenuTheme_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9" Height="9" Fill="#6EE7D8" VerticalAlignment="Center" />
                            <TextBlock x:Name="MenuThemeGraphiteText" Grid.Column="1" Text="石墨"
                                       FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeLg}"
                                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="MenuThemeGraphiteCheck" Grid.Column="2" Text="&#xE73E;"
                                       FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeMd}"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource MenuItemStyle}" Tag="porcelain" MouseLeftButtonUp="MenuTheme_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9" Height="9" Fill="#3D6BAA" VerticalAlignment="Center" />
                            <TextBlock x:Name="MenuThemePorcelainText" Grid.Column="1" Text="瓷白"
                                       FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeLg}"
                                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="MenuThemePorcelainCheck" Grid.Column="2" Text="&#xE73E;"
                                       FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeMd}"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="7,4" />
                    <TextBlock Text="工具" Style="{StaticResource MenuGroupTitleStyle}" />

                    <Border Style="{StaticResource MenuItemStyle}" MouseLeftButtonUp="MenuCalendar_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeLg}"
                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="日历" FontFamily="{StaticResource UiFont}"
                                       FontSize="{StaticResource FontSizeLg}" Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource MenuItemStyle}" MouseLeftButtonUp="MenuRefreshWeather_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeLg}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="刷新天气" FontFamily="{StaticResource UiFont}"
                                       FontSize="{StaticResource FontSizeLg}" Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource MenuItemStyle}" MouseLeftButtonUp="MenuClearLaunchers_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeLg}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="清空图标坞" FontFamily="{StaticResource UiFont}"
                                       FontSize="{StaticResource FontSizeLg}" Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource MenuItemStyle}" MouseLeftButtonUp="MenuOpenDataDir_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeLg}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="打开数据目录" FontFamily="{StaticResource UiFont}"
                                       FontSize="{StaticResource FontSizeLg}" Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource MenuItemStyle}" MouseLeftButtonUp="MenuLog_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeLg}"
                                       Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="打开日志" FontFamily="{StaticResource UiFont}"
                                       FontSize="{StaticResource FontSizeLg}" Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="7,4" />
                    <Border Style="{StaticResource MenuItemStyle}" MouseLeftButtonUp="MenuQuit_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource FontSizeLg}"
                                       Foreground="#FFFF7A7A" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="退出" FontFamily="{StaticResource UiFont}"
                                       FontSize="{StaticResource FontSizeLg}" Foreground="#FFFF7A7A" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Canvas>

        <!-- 图标坞右键菜单 -->
        <Canvas x:Name="LauncherMenuLayer" Visibility="Collapsed">
            <Border x:Name="LauncherMenuPanel" Width="134"
                    Background="{DynamicResource MenuBgBrush}" BorderBrush="{DynamicResource IslandBorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <StackPanel>
                    <Border CornerRadius="6" Padding="9,6" Cursor="Hand" Background="Transparent"
                            MouseLeftButtonUp="LauncherMenu_Reveal_Click">
                        <TextBlock Text="打开文件位置" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeMd}"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </Border>
                    <Border CornerRadius="6" Padding="9,6" Cursor="Hand" Background="Transparent"
                            MouseLeftButtonUp="LauncherMenu_Remove_Click">
                        <TextBlock Text="从图标坞移除" FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSizeMd}"
                                   Foreground="#FFFF7A7A" />
                    </Border>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
